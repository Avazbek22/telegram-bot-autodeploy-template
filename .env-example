# Required. Create a bot with @BotFather. Never commit the real token.
BOT_TOKEN=

# Optional human-readable name. The installer converts it to a unique APP_SLUG
# and pins it below, so renaming the directory never orphans the bot.
APP_NAME=

# Application defaults.
LOG_LEVEL=INFO
DATA_DIR=data
LOGS_DIR=logs
POLLING_TIMEOUT_SECONDS=20
LONG_POLLING_TIMEOUT_SECONDS=30
# The bot counts as healthy while Telegram answered getUpdates within this
# many seconds. It must exceed twice LONG_POLLING_TIMEOUT_SECONDS.
HEALTH_MAX_AGE_SECONDS=120

# Optional self-hosted Bot API server, for example http://telegram-bot-api:8081
TELEGRAM_API_URL=
